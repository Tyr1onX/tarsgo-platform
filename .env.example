APP_DOMAIN=:80
SESSION_COOKIE_SECURE=false

MYSQL_DATABASE=tarsgo
MYSQL_USER=tarsgo
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# AI planner (server-side only)
AI_PLANNER_ENABLED=false
AI_PLANNER_DAILY_REQUEST_LIMIT=100
AI_PROVIDER=gemini
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Gemini (Google Gen AI SDK / Interactions API):
# AI_PROVIDER=gemini
# GEMINI_API_KEY=<server-side key from Google AI Studio>
# GEMINI_MODEL=gemini-3.8-flash

# OpenAI:
# AI_PROVIDER=openai
# AI_API_KEY=<server-side key>
# AI_MODEL=<structured-output-capable model>

# DeepSeek example:
# AI_PROVIDER=deepseek
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-flash

# Knowledge sources are server-side; leave GitHub credentials out of Git.
KNOWLEDGE_ENABLED=false
KNOWLEDGE_GITHUB_REPO=
KNOWLEDGE_GITHUB_BRANCH=main
KNOWLEDGE_GITHUB_TOKEN=
KNOWLEDGE_GITHUB_PATHS=docs,knowledge
KNOWLEDGE_STORAGE_HOST_DIR=/opt/tarsgo-knowledge

# School leave material automation (server-side only)
LEAVE_CONTACT_PHONE=
LEAVE_DAILY_CUTOFF=11:30
SCHOOL_LEAVE_RESULT_STORAGE_HOST_DIR=/opt/tarsgo-data/school-leave-results
